# Copy to .env for local development. Every variable is optional.
# On the production host set them in the process manager / hosting settings instead; .env is not deployed.

# PORT: TCP port (default 3000) or a Unix socket path (some process managers pass one).
# PORT=3000

# NODE_ENV: "production" serves the built dist/ folder instead of the Vite dev server.
# NODE_ENV=production

# TRUST_PROXY: when the client address for the per-address limits may come from X-Forwarded-For.
# Unset (auto): only from a proxy on this host (loopback or a Unix socket). That is the safe default,
# because a client that reaches the app directly cannot forge the header. Set 1 when the reverse proxy
# runs on another host, 0 when the app is exposed directly.
# TRUST_PROXY=1

# ALLOWED_ORIGINS: comma-separated extra origins that may open the WebSocket (same-origin is always allowed).
# ALLOWED_ORIGINS="https://staging.example.com"

# SECURITY_HEADERS: "app" makes the app send the security headers itself (nosniff, X-Frame-Options,
# Referrer-Policy, Permissions-Policy and, in production, the CSP). Leave it unset when the web server
# already sets them (web server configuration), otherwise every header is sent twice.
# SECURITY_HEADERS=app

# DISABLE_HMR: set to "true" to turn off Vite hot reloading and file watching in the dev server.
# DISABLE_HMR=true
